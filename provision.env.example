# AirBridge provisioning config
# Copy to provision.env and fill in your values.
# This file is read by provision.py after flashing.
#
# Key names match $CONFIG keys. Only set what you need.
# Lines starting with # are ignored. Empty values are skipped.

# WiFi networks. Format: wifi_net=SSID PASSWORD
# Use double quotes if either field contains spaces:
#   wifi_net="My Home" "correct horse battery staple"
#   wifi_net=HomeNet "passphrase with spaces"
#   wifi_net=HomeNet hunter2
# Multiple wifi_net lines = multiple networks (max 4), applied in order via
# $WIFI ADD. Provisioning APPENDS - the device is not wiped first, so
# flashing a device with existing networks adds these on top. Use the web
# UI or $WIFI REMOVE to clean up if needed.
# wifi_net=MyHomeSSID my-home-password
# wifi_net="Office Network" office-pass

# wifi_mode: 0=auto (STA + AP fallback), 1=AP only, 2=off,
#            3=STA only, 4=STA+AP always
wifi_mode=0

# 2-letter ISO country code (US, DE, PL, JP, ...) or "01" for worldwide.
# wifi_country=01

# hostname=airbridge
# tz=UTC0
# ntp_server=

# http_user=admin
# http_pass=airbridge
# ota_password=airbridge
# oxi_device_addr=AA:BB:CC:DD:EE:FF
