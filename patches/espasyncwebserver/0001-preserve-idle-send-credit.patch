+++ b/WebResponses.cpp
@@ -393,7 +393,9 @@ size_t AsyncAbstractResponse::write_send_buffs(AsyncWebServerRequest *request, size_t len, uint32_t time) {
 // we were not able to fit all headers in current buff, send this part here and return later for the rest
 #if ASYNCWEBSERVER_USE_CHUNK_INFLIGHT
       _in_flight += pcb_written;
-      --_in_flight_credit;  // take a credit
+      if (pcb_written) {
+        --_in_flight_credit;  // take a credit only for queued data
+      }
 #endif
       if (!request->client()->send()) {
         // something is wrong, what should we do here?
@@ -415,6 +417,7 @@ size_t AsyncAbstractResponse::write_send_buffs(AsyncWebServerRequest *request, size_t len, uint32_t time) {
